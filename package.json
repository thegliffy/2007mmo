{
  "name": "2007mmo",
  "private": true,
  "description": "Hollowmere — woodland tick-MMO PoC by thegliffy",
  "scripts": {
    "start": "docker compose up --build",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "test": "go test ./...",
    "world": "go run ./cmd/world",
    "bots": "go run ./cmd/bots -n 50 -addr ws://127.0.0.1:8080/ws",
    "bots:hotspot": "go run ./cmd/bots -n 200 -hotspot -duration 45s -addr ws://127.0.0.1:8080/ws",
    "stats": "curl -s http://127.0.0.1:8080/stats",
    "metrics": "curl -s http://127.0.0.1:8080/metrics",
    "backup": "bash scripts/pg-backup.sh",
    "drill": "bash scripts/pg-backup-restore-drill.sh",
    "loop": "python3 scripts/week1-loop.py",
    "fight": "python3 scripts/south-fight.py"
  }
}
